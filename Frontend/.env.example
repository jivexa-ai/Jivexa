# ==============================================================================
# JIVEXA HEALTH OS - FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure your backend connection:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API BASE URL (Required)
# ------------------------------------------------------------------------------
# Local Development:
# VITE_API_BASE_URL=http://localhost:4000
# VITE_BACKEND_URL=http://localhost:4000
# VITE_API_URL=http://localhost:4000
#
# Production Deployed Backend:
VITE_API_BASE_URL=https://jivexa-main.onrender.com
VITE_BACKEND_URL=https://jivexa-main.onrender.com
VITE_API_URL=https://jivexa-main.onrender.com

# ------------------------------------------------------------------------------
# 2. APPLICATION MODES
# ------------------------------------------------------------------------------
VITE_PATIENT_MVP_ONLY=true

# ------------------------------------------------------------------------------
# NOTE ON API KEYS:
# All AI requests (Groq / Gemini) and authentication requests are securely
# processed through the backend server at /api/ai and /api/auth.
# Do NOT place private backend API keys or database secrets in this file.
# ------------------------------------------------------------------------------
