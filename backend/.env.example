# ==============================================================================
# JIVEXA HEALTH OS - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Core Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Primary Database: MongoDB Atlas (Mongoose)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=<your-jwt-secret-key>

# AI Engine Configuration (Google Gemini)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Authentication Feature Flags
# Set OTP_ENABLED=true to enable OTP verification
OTP_ENABLED=false

# Patient-First MVP Launch Mode
PATIENT_MVP_ONLY=true
