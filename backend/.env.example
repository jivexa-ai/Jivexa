# ==============================================================================
# JIVEXA HEALTH OS - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Core Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# JWT Authentication Secret
JWT_SECRET=<your-jwt-secret-key>

# AI Engine Configuration (Google Gemini)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Legacy MongoDB Database (Optional / Fallback)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Authentication Feature Flags
# TEMPORARILY DISABLED FOR LAUNCH
# Re-enable OTP after launch by setting OTP_ENABLED=true
OTP_ENABLED=false

